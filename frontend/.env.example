# Copy to .env.local and point at the LavaLust API
VITE_API_URL=http://localhost:8000/api

# true: every service returns sampleData.ts (daily work and the Playwright tests)
# false: services call VITE_API_URL (local Docker, or the live API on purpose)
VITE_USE_SAMPLE=true

# Pusher public values for live updates (key and cluster only, never the secret). Empty: screens use polling
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
