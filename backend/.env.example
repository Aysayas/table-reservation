# Table Reservation API environment. Copy to .env for local Docker.

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (Match docker-compose.yml values)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=table_reservation_db
DB_USER=table_reservation_user
DB_PASSWORD=table_reservation_pass
# Hosted MySQL only: path to the CA certificate file (leave empty locally)
DB_SSL_CA=

# For development, you can also use root
# DB_USER=root
# DB_PASSWORD=root

# Session
SESSION_DRIVER=file
SESSION_PATH=/var/www/html/runtime

# Timezone
APP_TIMEZONE=Asia/Manila

# API security (generate with: php -r "echo bin2hex(random_bytes(32));")
APP_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_REFRESH_KEY=change-me-to-at-least-32-random-characters

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Where PayMongo sends customers back after paying
FRONTEND_URL=http://localhost:5173

# PayMongo test keys. Leave empty for fake mode (no real checkout, the return page is used as the payment page)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Cloudinary for menu photos and the logo. Empty: files are saved in public/uploads (lost on every Render deploy)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pusher (live order updates). Empty: events are only logged
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Password reset email: the deployed Apps Script from docs/email-relay.gs. Empty: emails are only logged
MAIL_SCRIPT_URL=
MAIL_SCRIPT_SECRET=

# SMS through iProg SMS (iprogsms.com): the API token from its dashboard. Empty: texts are only logged (fake mode)
IPROG_SMS_TOKEN=
IPROG_SMS_PROVIDER=

# SMS reminders: the scheduled GitHub Action sends this in X-Cron-Secret. Empty: the reminders route answers 503
CRON_SECRET=

# Recommendation service (recommender/). Empty URL: best sellers and flagged items only.
# Local: docker compose --profile recommender up -d, then RECOMMENDER_URL=http://recommender:8001 and RECOMMENDER_SECRET=local-recommender-secret
RECOMMENDER_URL=
RECOMMENDER_SECRET=
