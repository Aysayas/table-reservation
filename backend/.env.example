# Copy this file to .env and update the values below.
# LavaLust reads .env itself (scheme/kernel/LavaLust.php).
# setup-new-project.ps1 / start.ps1 fill in the keys and passwords.

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration (DB_HOST=mysql is the docker-compose service)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=table_reservation_user
DB_PASSWORD=
DB_NAME=table_reservation_db
DB_CHARSET=utf8mb4
DB_PREFIX=
# TLS for managed MySQL (e.g. Aiven): path to the provider's CA file.
# Empty = no TLS (the local container). Only DB_SSL_VERIFY=false skips
# certificate verification.
DB_SSL_CA=
DB_SSL_VERIFY=true

# For API (php lava jwt:generate)
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Exact origin allowed to call the API (empty = no CORS headers)
CORS_ALLOW_ORIGIN=http://localhost:3000
# TRUE only behind a TLS-terminating proxy (Render)
TRUST_PROXY=false

# docker-compose only
DB_ROOT_PASSWORD=
APP_PORT=80
DB_FORWARD_PORT=3306
PMA_PORT=8080

# Docker project name, keeps this stack and its volume separate from other projects
COMPOSE_PROJECT_NAME=table-reservation
